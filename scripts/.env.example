# .env.example
# Copy to .env before running ./start.sh
# All variables below are read by Python scripts, dbt, and shell scripts.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
# Host port mapping — internal port is always 5432. Change host port if 5434
# is already in use on your machine (the build used 5434 after two conflicts).
POSTGRES_HOST_PORT=5434

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Host-side bootstrap address (for Python scripts running on the host)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Internal bootstrap address (for services inside Docker — Flink, ClickHouse)
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:29092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=default
# Native TCP port used by clickhouse-driver (Python).
# Host-mapped port — internal port is always 9000.
# Used by benchmarks/e2e_latency_test.py and great_expectations/run_checkpoint.py
# when run from the host. Services inside Docker use port 9000 directly.
CLICKHOUSE_NATIVE_PORT=19000

# ── Slack (optional) ──────────────────────────────────────────────────────────
# Used by dlq/dlq_consumer.py to send sink failure alerts.
# Leave blank to disable Slack alerts (the DLQ consumer still writes to ClickHouse).
SLACK_WEBHOOK_URL=

# ── Docker socket (for failure recovery tests) ────────────────────────────────
# tests/test_failure_recovery.py uses the Docker Python SDK to stop/start
# containers. If you run multiple Docker contexts, the SDK may connect to the
# wrong one. Set this to the socket path for the context running this project.
#
# Find the correct path with: docker context ls
# Common values:
#   Linux (Docker Engine):   unix:///var/run/docker.sock
#   macOS Docker Desktop:    unix:///Users/<you>/.docker/run/docker.sock
#   Linux Docker Desktop:    unix:///home/<you>/.docker/desktop/docker.sock
#
# The test_failure_recovery.py script reads this variable. If unset, it
# defaults to unix:///var/run/docker.sock.
DOCKER_HOST=unix:///var/run/docker.sock

# ── dbt flash sale vars ───────────────────────────────────────────────────────
# These are set automatically by ./scripts/run_load.sh flash_sale.
# You can also set them manually here if you want dbt to always use specific
# flash sale window times (e.g. after re-running dbt without re-running load).
# Format: YYYY-MM-DD HH:MM:SS (UTC)
# FLASH_SALE_START=2025-01-25 14:00:00
# FLASH_SALE_END=2025-01-25 14:05:00
