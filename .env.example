POSTGRES_HOST=localhost
# Use 5433 when docker-compose maps host 5433 -> container 5432 (see docker-compose.yml).
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
# Connection pool for load_generator.py (must be >= concurrent workers; max_workers caps at this).
POSTGRES_POOL_MINCONN=2
POSTGRES_POOL_MAXCONN=96
# Seed volume (defaults match original spec: 1000 customers, 200 products, high stock for flash_sale).
SEED_CUSTOMER_COUNT=1000
SEED_PRODUCT_COUNT=200
SEED_INVENTORY_MIN=500
SEED_INVENTORY_MAX=5000
# Optional: set for reproducible seed data (emails/SKUs use seeded RNG, not only Faker).
LOAD_SEED=
# Timed load tuning
LOAD_NORMAL_TPS=10
LOAD_FLASH_TPS=50
LOAD_FLASH_DURATION_SEC=300
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=default
SLACK_WEBHOOK_URL=https://hooks.slack.com/your-webhook-here