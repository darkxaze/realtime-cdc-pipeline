POSTGRES_HOST=localhost
# docker-compose maps host 5434 -> container 5432 (see docker-compose.yml).
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
# Connection pool for load_generator.py (must be >= concurrent workers; max_workers caps at this).
POSTGRES_POOL_MINCONN=2
POSTGRES_POOL_MAXCONN=96
# Seed volume (defaults match original spec: 1000 customers, 200 products, high stock for flash_sale).
SEED_CUSTOMER_COUNT=1000
SEED_PRODUCT_COUNT=200
SEED_INVENTORY_MIN=50
SEED_INVENTORY_MAX=200
# Optional: set for reproducible seed data (emails/SKUs use seeded RNG, not only Faker).
LOAD_SEED=
# Timed load tuning
LOAD_NORMAL_TPS=10
LOAD_FLASH_TPS=50
LOAD_FLASH_DURATION_SEC=300
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
# Native protocol from host; docker-compose maps 19000 -> container 9000.
CLICKHOUSE_NATIVE_PORT=19000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default
# Kafka Connect REST API (used by test_failure_recovery.py and connector setup).
KAFKA_CONNECT_URL=http://localhost:8083
# --- Stage 4: DLQ, failure recovery tests, Slack alerts ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/your-webhook-here
# Set this if Docker SDK connects to wrong context.
# Find your socket path with: docker context ls
DOCKER_HOST=unix:///home/nastavirs/.docker/desktop/docker.sock
# Compose project name defaults to the repo directory name; set explicitly if it differs.
# COMPOSE_PROJECT_NAME=reatime-cdc-pipleine
# DLQ consumer tuning (dlq_consumer.py).
KAFKA_DLQ_AUTO_OFFSET_RESET=earliest
KAFKA_PRODUCER_FLUSH_TIMEOUT_SEC=30
SLACK_REQUEST_TIMEOUT_SEC=10
